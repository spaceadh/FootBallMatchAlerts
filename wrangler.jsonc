{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-match-alerts",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [
    {
      "binding": "MATCH_KV",
      "id": "YOUR_KV_NAMESPACE_ID" // Replace with your KV ID from Cloudflare
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"] // Runs every 5 minutes
  }
}