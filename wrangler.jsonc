{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footballmatchalerts",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [
    {
      "binding": "MATCH_KV",
      "id": "ab56494c3a3343d1afbd862bb6270368" // Replace with your actual KV ID from Step 1
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}