{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footballmatchalerts",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [
    {
      "binding": "MATCH_KV",
      "id": "e.g._3a8b2c9d1e4f5a6b7c8d9e0f" // Replace with your actual KV ID from Step 1
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}